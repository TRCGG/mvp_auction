{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "live",
  "main": "src/index.js",
  "compatibility_date": "2025-05-01",

  // 정적 파일(public/)은 Worker를 거치지 않고 바로 서빙됩니다.
  // /api/* 만 Worker로 들어옵니다.
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application"
  },

  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "AuctionRoom" },
      { "name": "REGISTRY", "class_name": "Registry" }
    ]
  },

  // 무료 플랜은 SQLite 백엔드만 생성할 수 있습니다.
  // new_classes(키-값 방식)로 쓰면 배포가 거부됩니다.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AuctionRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["Registry"] }
  ],

  "observability": { "enabled": true }
}
